{
  "name": "ps-tracker",
  "main": "worker.js",
  "compatibility_date": "2025-10-01",
  "assets": { "directory": "./", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "BOOK", "class_name": "BookDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BookDO"] }]
}
